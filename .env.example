# ===== التشغيل السحابي (Vercel) =====
# رابط PostgreSQL من Supabase (Connect ← Transaction pooler — المنفذ 6543)
DATABASE_URL=
# مفتاح سري لتشغيل النسخ الاحتياطي المجدول (أي نص طويل عشوائي)
CRON_SECRET=
# اختياري: لحفظ النسخ الاحتياطية في Supabase Storage (أنشئ Bucket خاصاً اسمه backups)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
BACKUP_BUCKET=backups

# ===== التشغيل المحلي =====
# بدون DATABASE_URL تُحفظ البيانات في مجلد data/ والنسخ الاحتياطية في backups/ تلقائياً كل 24 ساعة
# BACKUP_DIR=D:\\amlak-backups
# كلمة مرور المدير عند أول تشغيل فقط (الافتراضية admin123 ويُطلب تغييرها)
ADMIN_PASSWORD=
